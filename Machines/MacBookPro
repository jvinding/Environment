asap:token-staging() {
    local lifespan=${1:-15}
    local subject=${2:-"printavo:16333"}
    asap

    ./src/Inktavo.Asap.Console/bin/Debug/net8.0/Inktavo.Asap.Console \
    create-token \
    -k keys/KuEks6FNxlhTN3SgOgxPfIJz4mWdPtuFhAOgeQR0FL8_private.json \
    -l $lifespan \
    -e Staging \
    -i pds_example \
    -a product_service \
    -s "$subject"
}

asap:query-staging() {
    local query=${1:-G500}
    asap

    ./src/Inktavo.Asap.Console/bin/Debug/net8.0/Inktavo.Asap.Console \
    query -p \
    -t $(asap:token-staging) \
    -e Staging \
    -q "$query"
}

