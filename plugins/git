alias abandon=git_abandon_branch
alias branch=git_branch
alias stage=git_stage
alias add=git_add
alias pr=git_update
alias push=git_push
alias gup=git_cdup
alias gw=git_worktree_add
alias gclone=git_clone_bare
alias gwl='git worktree list'
alias gwp='git worktree prune'

