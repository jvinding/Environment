#
# Git Plugin
# General git utilities and helpers
#

#
# Internal Helpers
#

__git_confirm() {
    local prompt="${1:-Continue?}"
    read -p "$prompt " -n1 response
    echo
    [[ "$response" =~ ^[Yy]$ ]]
}

__git_with_stash() {
    local stash_msg="${1:-auto stash}"
    shift
    local had_changes=false

    if [[ -n "$(git_change_list)" ]]; then
        git stash save --include-untracked "$stash_msg" || return 1
        had_changes=true
    fi

    if [[ -n "$(git_change_list)" ]]; then
        echo "Unstashable changes" >&2
        return 1
    fi

    "$@"
    local result=$?

    if $had_changes; then
        git stash pop
    fi

    return $result
}

#
# Core Utilities
#

if which hub > /dev/null; then
    alias github='hub browse'
else
    github() {
        if [[ ! -d .git ]]; then
            echo "Error: This isn't a git directory" >&2
            return 1
        fi

        local git_url=$(git ls-remote --get-url origin)
        local git_domain=$(echo "$git_url" | awk -v FS="(@|:)" '{print $2}')
        local git_branch=$(git_get_branch)

        if [[ $git_url == https://* ]]; then
            url="${git_domain}/${git_url%.git}/tree/${git_branch}"
        elif [[ $git_url == git@* ]]; then
            url="https://${git_domain}/${${git_url#*:}%.git}/tree/${git_branch}"
        else
            echo "Error: Remote origin is invalid" >&2
            return 1
        fi

        open "$url"
    }
fi

git_get_config_file() {
    local done=0
    local file=
    local gitdir=.git
    while [[ $done -eq 0 ]]; do
        if [[ -d "$gitdir" ]]; then
            if [[ -f "${gitdir}/config" ]]; then
                file="${gitdir}/config"
            fi
            done=1
        elif [[ -f "$gitdir" ]]; then
            gitdir=$(grep gitdir "$gitdir" | awk '{print $2}')
        else
            done=1
        fi
    done

    echo -n "$file"
}

git_assert_clean_tree() {
    local changes=$(git_change_list)
    if [[ -n "$changes" ]]; then
        echo "Uncommitted changes. Stash them then try again."
        return 1
    fi
}

git_cdup() {
    git branch > /dev/null 2>&1 || return 1
    cd "$(git rev-parse --show-cdup)".
}

git_get_branch() {
    git symbolic-ref --short HEAD 2> /dev/null
}

git_get_tracked_branch() {
    git config --get "branch.$(git_get_branch).merge"
}

git_has_branch() {
    git branch --list "$1" | grep -q .
}

git_is_on_branch() {
    [[ "$(git_get_branch)" == "$1" ]]
}

git_change_list() {
    git ls-files -cdmosuk --exclude-standard | awk '{print $NF}'
}

#
# Branch Operations
#

git_branch() {
    local branch=$1
    if git_is_on_branch "$branch"; then
        echo "Already on branch $branch"
    elif git_has_branch "$branch"; then
        git co "$branch"
        git merge master
    else
        if ! git_is_on_branch master; then
            git checkout master || { echo "Failed to check out master" >&2; return 1; }
        fi
        git pull || { echo "Failed to pull" >&2; return 1; }
        git co -b "$branch" || { echo "Failed to create branch $branch" >&2; return 1; }
    fi
}

git_abandon_branch() {
    if git_is_on_branch master; then
        return 0
    fi

    local changes=$(git_change_list)
    if [[ -n "$changes" ]]; then
        git_change_list
        if __git_confirm "Abandon changes to the above files? y/N"; then
            git checkout . || { echo "Failed to checkout" >&2; return 1; }
        else
            return 0
        fi
    fi

    local branch=$(git_get_branch)
    git checkout master || { echo "Failed to check out master" >&2; return 1; }
    git branch -d "$branch" || {
        if __git_confirm "Do you want to force deletion of the branch ${branch}? y/N"; then
            git branch -D "$branch"
        fi
    }
}

#
# Staging Operations
#

git_prompt_stage() {
    local file="$1"
    local ignore_white_space=${2:-false}

    if [[ "$ignore_white_space" == "true" ]]; then
        git diff -w -- "$file"
    else
        git diff -- "$file"
    fi

    read -p "Stage the above file? y/p/w/N " -n1 stage
    echo

    case "$stage" in
        [Yy]) git add -- "$file" || { echo "Failed to stage" >&2; return 1; } ;;
        [Pp]) git add --patch -- "$file" || { echo "Failed to stage" >&2; return 1; } ;;
        [Ww]) git_prompt_stage "$file" true ;;
    esac
}

git_stage() {
    for s in $(git_change_list); do
        git_prompt_stage "$s" false
    done
}

git_add() {
    for s in $(git ls-files -o --exclude-standard); do
        echo "$s"
        read -p "Stage the above file? y/N/q " -n1 stage
        echo

        case "$stage" in
            [Yy]) git add "$s" || { echo "Failed to stage" >&2; return 1; } ;;
            [Qq]) return 0 ;;
        esac
    done
}

#
# Sync Operations
#

git_update() {
    git submodule update --recursive

    __git_with_stash "git update stash" git pull --rebase || return 1

    git submodule update --recursive
}

git_push() {
    __git_with_stash "[$(date +"%Y-%m-%d")] git push stash" bash -c 'git pull --rebase && git push'
}

#
# Repository Utilities
#

git_find_unclean_repos() {
    for s in $(find . -maxdepth 1 -type d); do
        pushd "$s" > /dev/null
        if [[ -d .git ]] && ! git_assert_clean_tree > /dev/null; then
            pwd
        fi
        popd > /dev/null
    done
}

git_update_all() {
    for s in $(find . -type d -maxdepth 1 -not -name '.*'); do
        echo "$s"
        pushd "$s" > /dev/null
        git pull --rebase -q
        popd > /dev/null
    done
}

#
# Aliases
#

alias abandon=git_abandon_branch
alias branch=git_branch
alias stage=git_stage
alias add=git_add
alias pr=git_update
alias push=git_push
alias gup=git_cdup
