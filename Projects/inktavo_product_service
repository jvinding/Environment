}
ips:ai_staging_worker_ssh() {
  aws:sso:login_if_needed staging_ai
  aws:eb:ssh staging_ai ips-staging-worker
}
ips:db:production_tunnel() {
  aws:sso:login_if_needed production_services
  aws:eb:db_ssh_tunnel pds-ips-production.pem "prod-$(ips:production_worker_instance_id)" ${__IPS_PRODUCTION_DB_HOSTNAME} 5432 6542
}
ips:db:staging_tunnel() {
  aws:sso:login_if_needed staging_services
  aws:eb:db_ssh_tunnel pds-ips-staging.pem $(ips:staging_worker_instance_id) ${__IPS_STAGING_DB_HOSTNAME} 5432 6543
}
ips:db:ai_staging_tunnel() {
  aws:sso:login_if_needed staging_ai
  aws:eb:db_ssh_tunnel pds-ips-ai-staging.pem "staging-ai-$(ips:ai_staging_worker_instance_id)" ${__IPS_AI_STAGING_DB_HOSTNAME} 5432 6541
}

ips:db:production_tunnel_close() {
  aws:eb:db_ssh_tunnel_close "${__IPS_PRODUCTION_DB_HOSTNAME}"
}
ips:db:staging_tunnel_close() {
  aws:eb:db_ssh_tunnel_close "${__IPS_STAGING_DB_HOSTNAME}"
}
ips:db:ai_staging_tunnel_close() {
  aws:eb:db_ssh_tunnel_close "${__IPS_AI_STAGING_DB_HOSTNAME}"
}

ips:os:production_tunnel() {
  aws:sso:login_if_needed production_services
  aws:eb:db_ssh_tunnel pds-ips-production.pem "prod-$(ips:production_worker_instance_id)" ${__IPS_PRODUCTION_OS_HOSTNAME} 443 6443
}
ips:os:staging_tunnel() {
  aws:sso:login_if_needed staging_services
  aws:eb:db_ssh_tunnel pds-ips-staging.pem "$(ips:staging_worker_instance_id)" ${__IPS_STAGING_OS_HOSTNAME} 443 6444
}
ips:os:production_tunnel_close() {
    pkill -lf "${__IPS_PRODUCTION_OS_HOSTNAME}"
}
ips:os:staging_tunnel_close() {
    pkill -lf "${__IPS_STAGING_OS_HOSTNAME}"
}
