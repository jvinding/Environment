__ips:console:prep() {
  local environment=${1}
  aws:sso:login_if_needed $environment

  echo "Opening ${environment} console..."
  echo "Run the following commands to open the Rails console"
  echo '$(/opt/elasticbeanstalk/bin/get-config environment | jq -r '\''to_entries | .[] | "export \\(.key)=\\(.value)"'\'')'
  echo "/var/app/current/bin/rails c"
}
ips:console:production() {
  __ips:console:prep production_services
  ips:ssh:production:worker
}
ips:console:ai_staging() {
  __ips:console:prep staging_ai
  ips:ai_staging_worker_ssh
}
ips:console:staging() {
  __ips:console:prep staging_services
  ips:staging_worker_ssh
}
