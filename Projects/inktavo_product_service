# ------------------------------------------------------------------------------
# Private Helpers
# ------------------------------------------------------------------------------

__ips:console:prep() {
  local environment=${1}
  aws:sso:login_if_needed $environment

  echo "Opening ${environment} console..."
  echo "Run the following commands to open the Rails console"
  echo '$(/opt/elasticbeanstalk/bin/get-config environment | jq -r '\''to_entries | .[] | "export \\(.key)=\\(.value)"'\'')'
  echo "/var/app/current/bin/rails c"
}
