ips:db:production_tunnel() {
  aws:sso:login_if_needed production_services
  aws:eb:db_ssh_tunnel pds-ips-staging.pem "prod-$(ips:production_worker_instance_id)" ${__IPS_PRODUCTION_DB_HOSTNAME} 5432 6542
}
ips:db:staging_tunnel() {
  aws:sso:login_if_needed staging_services
  aws:eb:db_ssh_tunnel pds-ips-staging.pem $(ips:staging_worker_instance_id) ${__IPS_STAGING_DB_HOSTNAME} 5432 6543
}
ips:db:production_tunnel_close() {
    pkill -lf "${__IPS_PRODUCTION_DB_HOSTNAME}"
}
ips:db:staging_tunnel_close() {
    pkill -lf "${__IPS_STAGING_DB_HOSTNAME}"
}

