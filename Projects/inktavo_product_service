alias ips="cd '$HOME/Documents/2. Areas/Product Service/product_service'"

export REDIS_URL=redis://localhost:6380

alias ips:prod_run='heroku run -a $IPS_APP_NAME_PROD -- '
alias ips:prod_console='ips:prod_run rails console'
alias ips:prod_logs='heroku logs -a $IPS_APP_NAME_PROD --tail --dyno web'
alias ips:prod_logs_sidekiq='heroku logs -a $IPS_APP_NAME_PROD --tail --dyno queues'
alias ips:prod_psql='heroku psql -a $IPS_APP_NAME_PROD'

alias ips:update='ips && merge_branch && dip:rebuild'
alias ips:rebase='ips && rebase_branch && dip:rebuild'

ips:console_with_new_relic() {
  ips

  export NEW_RELIC_LICENSE_KEY=${__NEW_RELIC_LICENSE_KEY}
  export NEW_RELIC_APP_NAME=${__NEW_RELIC_APP_NAME}
  # export RAILS_ENV=production
  bundle exec rails console
}

ips:db_down() {
  ips

  if __safe_to_run_db_command; then
    if [ -z "$1" ]; then
      bundle exec rake db:rollback STEP=1 RAILS_ENV=development
    else
      bundle exec rake db:migrate:down VERSION=$1
    fi
  fi
}

ips:db_up() {
  ips

  if __safe_to_run_db_command; then
    if [ -z "$1" ]; then
      bundle exec rake db:migrate STEP=1 RAILS_ENV=development
    else
      bundle exec rake db:migrate:up VERSION=$1
    fi
  fi
}


ips:performance_web_instance_id() {
  aws:eb:instance_id staging_services ips-performance-web
}
ips:performance_web_instance_ip() {
  aws:eb:instance_ip "$(ips:performance_web_instance_id)"
}
ips:performance_web_instance_dns() {
  aws:eb:instance_dns "$(ips:performance_web_instance_id)"
}
ips:performance_web_ssh() {
  aws:sso:login_if_needed staging_services
  aws:eb:ssh staging_services ips-performance-web
}
ips:performance_worker_ssh() {
  aws:sso:login_if_needed staging_services
  aws:eb:ssh staging_services ips-performance-worker
}

ips:staging_web_instance_id() {
  aws:eb:instance_id staging_services ips-staging-web
}
ips:staging_worker_instance_id() {
  aws:eb:instance_id staging_services ips-staging-worker
}
ips:staging_web_ssh() {
  aws:sso:login_if_needed staging_services
  aws:eb:ssh staging_services ips-staging-web
}
ips:staging_worker_ssh() {
  aws:sso:login_if_needed staging_services
  aws:eb:ssh staging_services ips-staging-worker
}

ips:production_worker_instance_id() {
  aws:eb:instance_id production_services ips-production-worker
}

ips:ai_staging_worker_instance_id() {
