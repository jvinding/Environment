ips:console:production() {
  __ips:console:prep production_services
  ips:ssh:production:worker
}

ips:db:production:dumps:fetch() {
  aws:sso:login_if_needed production_services
  local most_recent_backup=$(aws --profile production_services \
    s3api list-objects-v2 \
    --bucket product-service-shared-bucket \
    --query "Contents[?contains(Key, 'anon-dump')].Key" \
    --output json \
    | jq -r '.[]' \
    | tail -1)
  aws --profile production_services \
    s3 cp \
    "s3://product-service-shared-bucket/${most_recent_backup}" ~/Downloads
}

ips:db:production:dumps:list() {
