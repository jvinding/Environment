alias ips="cd '$HOME/Documents/2. Areas/Product Service/product_service'"

export REDIS_URL=redis://localhost:6380

alias ips:prod_run='heroku run -a $IPS_APP_NAME_PROD -- '
alias ips:prod_console='ips:prod_run rails console'
alias ips:prod_logs='heroku logs -a $IPS_APP_NAME_PROD --tail --dyno web'
alias ips:prod_logs_sidekiq='heroku logs -a $IPS_APP_NAME_PROD --tail --dyno queues'
alias ips:prod_psql='heroku psql -a $IPS_APP_NAME_PROD'

alias ips:staging_run='heroku run -a $IPS_APP_NAME_STAGING -- '
alias ips:staging_console='ips:staging_run rails console'
alias ips:staging_logs='heroku logs -a $IPS_APP_NAME_STAGING --tail --dyno web'
alias ips:staging_psql='heroku psql -a $IPS_APP_NAME_STAGING'

alias ips:update='ips && merge_branch && dip:rebuild'
alias ips:rebase='ips && rebase_branch && dip:rebuild'

ips:console_with_new_relic() {
  ips

  export NEW_RELIC_LICENSE_KEY=${__NEW_RELIC_LICENSE_KEY}
  export NEW_RELIC_APP_NAME=${__NEW_RELIC_APP_NAME}
  # export RAILS_ENV=production
  bundle exec rails console
}

ips:db_down() {
  ips

  if __safe_to_run_db_command; then
    if [ -z "$1" ]; then
      bundle exec rake db:rollback STEP=1 RAILS_ENV=development
    else
      bundle exec rake db:migrate:down VERSION=$1
    fi
  fi
}

ips:db_up() {
  ips

  if __safe_to_run_db_command; then
    if [ -z "$1" ]; then
      bundle exec rake db:migrate STEP=1 RAILS_ENV=development
    else
      bundle exec rake db:migrate:up VERSION=$1
    fi
  fi
}


awseb:instance_id() {
  local env=$1
  if [ -n "$1" ]; then
    aws --profile=staging_services elasticbeanstalk describe-environment-resources --environment-name=$env | jq -r '.EnvironmentResources.Instances[0].Id'
  fi
}
awseb:instance_ip() {
  local instance_id=$1
  if [ -n "$1" ]; then
    aws --profile=staging_services ec2 describe-instances --instance-ids "$instance_id" | jq -r '.Reservations[0].Instances[0].PublicIpAddress'
  fi
}
awseb:instance_dns() {
  local instance_id=$1
  if [ -n "$1" ]; then
    aws --profile=staging_services ec2 describe-instances --instance-ids "$instance_id" | jq -r '.Reservations[0].Instances[0].PublicDnsName'
  fi
}
awseb:ssh() {
  local profile=$1
  local env=$2
  if [ -n "$env" ] && [ -n "$profile" ]; then
    local instance_id=$(awseb:instance_id "$env")
    if [ -n "$instance_id" ]; then
      aws --profile "$profile" ssm start-session --target "$instance_id"
    fi
  fi
}
awseb:db_ssh_tunnel() {
  local identity=$1
  local env=$2
  local db_hostname=$3
  local db_port=${4:-5432}
  local local_port=${5:-5432}
  if [ -n "$identity" ] && [ -n "$db_hostname" ] && [ -n "$env" ]; then
    local instance_id=$(awseb:instance_id "$env")
    if [ -n "$instance_id" ]; then
      ssh -i "~/.ssh/$identity" -Nf "ec2-user@$instance_id" -L ${local_port}:${db_hostname}:${db_port}
    fi
  fi
}

ips:performance_web_instance_id() {
  awseb:instance_id ips-performance-web
}
ips:performance_web_instance_ip() {
  awseb:instance_ip "$(ips:performance_web_instance_id)"
}
ips:performance_web_instance_dns() {
  awseb:instance_dns "$(ips:performance_web_instance_id)"
}
ips:performance_web_ssh() {
  awseb:ssh staging_services ips-performance-web
}
ips:performance_worker_ssh() {
  awseb:ssh staging_services ips-performance-worker
}

ips:staging_web_ssh() {
  awseb:ssh staging_services ips-staging-web
}
ips:staging_worker_ssh() {
  awseb:ssh staging_services ips-staging-worker
}

ips:staging_tunnel() {
  awseb:db_ssh_tunnel ips-staging ips-staging-web ${__IPS_STAGING_DB_HOSTNAME} 5432 6543
}
ips:staging_tunnel_close() {
    pkill -lf "${__IPS_STAGING_DB_HOSTNAME}"
}