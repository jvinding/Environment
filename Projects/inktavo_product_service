alias ips="cd '$HOME/Documents/2. Areas/Product Service/product_service'"

export REDIS_URL=redis://localhost:6380
# export RAILS_ENV=development

alias ips:update='ips && merge_branch && dip:rebuild'
alias ips:rebase='ips && rebase_branch && dip:rebuild'

# ------------------------------------------------------------------------------
# Local Development
# ------------------------------------------------------------------------------

ips:console:local:newrelic() {
  ips
  export NEW_RELIC_LICENSE_KEY=${__NEW_RELIC_LICENSE_KEY}
  export NEW_RELIC_APP_NAME=${__NEW_RELIC_APP_NAME}
  bundle exec rails console
}

ips:db:local:down() {
  ips
  if __safe_to_run_db_command; then
    if [ -z "$1" ]; then
      bundle exec rake db:rollback STEP=1 RAILS_ENV=development
    else
      bundle exec rake db:migrate:down VERSION=$1
    fi
  fi
}

ips:db:local:hero() {
  docker run -ti \
    -e DATABASE_URL=postgres://user:password@hostname:5432/dbname \
    -e PGHERO_STATS_DATABASE_URL=... \
    -p 8080:8080 \
    ankane/pghero
}

ips:db:local:up() {
  ips
  if __safe_to_run_db_command; then
    if [ -z "$1" ]; then
      bundle exec rake db:migrate STEP=1 RAILS_ENV=development
    else
      bundle exec rake db:migrate:up VERSION=$1
    fi
  fi
}

